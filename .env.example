# sofia-eval — copie para .env e preencha. O .env está no .gitignore.
# NENHUM segredo entra no repositório.
#
# As credenciais do Google e o segredo do webhook já vivem no .env do
# sofia-bot. Em vez de duplicar segredo em dois arquivos, aponte para lá:
# o que faltar aqui é lido de SOFIA_BOT_ENV.
SOFIA_BOT_ENV=~/sofia-bot/.env

# ---- Banco -------------------------------------------------------------
# Só o banco de teste. O eval TRUNCA tabelas antes de cada cenário e recusa
# rodar contra qualquer banco cujo nome não seja `sofia_test`.
DATABASE_URL=postgresql://sofia_test:test@localhost:5432/sofia_test

# ---- Servidor local do sofia-bot ---------------------------------------
# O eval NÃO sobe o servidor. Suba você: `cd ~/sofia-bot && npm start`.
SOFIA_URL=http://localhost:3000

# Tem de ser o MESMO valor que o servidor do sofia-bot carregou, senão o
# webhook devolve 401 e nada funciona.
WHATSAPP_APP_SECRET=

# phone_number_id fictício do tenant criado pelo eval — não pode colidir com
# nenhum tenant real.
EVAL_PHONE_NUMBER_ID=999000999000999

# ---- Google Calendar (conta dedicada) ----------------------------------
# Conta separada, projeto próprio no Cloud, usada só pelo eval.
# ATENÇÃO: o eval APAGA todos os eventos da janela de limpeza neste
# calendário, entre cada cenário. Nunca aponte para a agenda de um cliente.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Trava de segurança: o eval confere que o refresh token pertence mesmo a
# esta conta antes de apagar qualquer coisa. Sem bater, recusa rodar.
EVAL_GOOGLE_ACCOUNT=a-conta-dedicada@exemplo.com
EVAL_GOOGLE_CALENDAR_ID=primary

# ---- Ajustes finos (opcionais) -----------------------------------------
# Teto de espera por turno. Um turno é uma chamada real de LLM, às vezes com
# várias ferramentas em sequência.
EVAL_TIMEOUT_TURNO_S=120
EVAL_POLL_INTERVALO_S=0.3
# Carência antes de aceitar um status final da fila como falha real do turno.
EVAL_CARENCIA_STATUS_S=8
EVAL_TIMEOUT_HTTP_S=30
# Quantos dias à frente a limpeza de calendário varre.
EVAL_JANELA_LIMPEZA_DIAS=45
